# VCS metadata and local agent/IDE state.
.git
.git/**
.gitignore
.gitattributes
.github
.github/**
.agents
.agents/**
.claude
.claude/**
.codex
.codex/**
.gitfox
.gitfox/**
.idea
.idea/**
.vscode
.vscode/**

# Local environment and secrets.
.env
.env.*
!.env.example
config/db.php
config/my.php

# CI, release, and source-build tooling that is not needed at runtime.
Jenkinsfile
Makefile
build/
build/**
release/
release/**
tools/
tools/**
docker-compose*.yml
docker-compose*.yaml

# Tests and test runtime output.
test/
test/**
framework/tests/
framework/tests/**
module/**/test/
module/**/test/**
**/.phpunit.result.cache
coverage/
coverage/**

# Runtime-generated data. The image recreates writable runtime dirs itself.
tmp/
tmp/**
data/
data/**
www/data/
www/data/**
www/xhprof/
www/xhprof/**
*.log
*.pid
*.tmp
!www/install.php.tmp
!www/upgrade.php.tmp

# Runtime install/upgrade entry files are restored from the tracked templates.
www/install.php
www/upgrade.php
www/checklist.php
www/ok.txt

# Common local caches and dependency folders unrelated to the PHP runtime tree.
node_modules/
node_modules/**
.cache/
.cache/**
.pytest_cache/
.pytest_cache/**
__pycache__/
__pycache__/**
*.pyc

# Local package/export artifacts at the repository root.
/*.tar
/*.tar.gz
/*.tgz
/*.zip
/*.bak
